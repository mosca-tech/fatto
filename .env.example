# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# chiave pubblica: "anon" oppure "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chiave segreta: "service_role" oppure "secret". Mai nel browser, mai su GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Email Google autorizzate ad accedere, separate da virgola
ALLOWED_EMAILS=tuo.indirizzo@gmail.com

# Per le API usate da Siri e dall'agente email
# ID del tuo utente: Supabase > Authentication > Users (dopo il primo accesso)
OWNER_USER_ID=
# Chiave segreta lunga a piacere (almeno 24 caratteri), es. generata con: openssl rand -hex 32
TASKS_API_TOKEN=

# Riepilogo di fine giornata via email (Resend, resend.com)
# Chiave API di Resend con permesso "Sending access"
RESEND_API_KEY=
# Dove arriva il riepilogo. Senza un dominio verificato su Resend deve essere l'email con cui hai creato l'account Resend
DIGEST_TO=
# Facoltativo. Mittente; di base "Fatto <onboarding@resend.dev>"
DIGEST_FROM=
# Stringa lunga a piacere (almeno 24 caratteri): Vercel la manda al cron e l'app controlla che coincida
CRON_SECRET=
